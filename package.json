{
  "name": "kpi-calculator",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node scripts/start-backend.mjs",
    "server:rebuild": "node scripts/start-backend.mjs --rebuild",
    "db:init": "node scripts/init-database.mjs",
    "start": "node scripts/start-backend.mjs --prod",
    "prebuild": "node scripts/check-server.mjs && node scripts/healthcheck.mjs",
    "build": "vite build",
    "prelint": "node scripts/check-server.mjs",
    "lint": "eslint .",
    "lint:server-v4": "eslint \"server-v4/src/**/*.ts\"",
    "format:check": "prettier --check eslint.config.js package.json prettier.config.js \".github/workflows/**/*.yml\" \"server/ecus/**/*.js\" \"server/https/**/*.js\"",
    "format:write": "prettier --write eslint.config.js package.json prettier.config.js \".github/workflows/**/*.yml\" \"server/ecus/**/*.js\" \"server/https/**/*.js\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "vitest run \"tests/server.*.test.js\" --environment node",
    "test:server-v4": "vitest run tests/server-v4 --environment node",
    "test:frontend": "vitest run \"tests/**/*.test.js\" \"tests/**/*.test.jsx\" --environment jsdom",
    "test:smoke:backend-core": "vitest run tests/server.seed.test.js tests/businessSnapshotSqlite.test.js tests/teamRosterSqlite.test.js tests/reportingProjectionSqlite.test.js tests/reportingObservability.test.js tests/server.ecusBridgeService.test.js tests/server.ecusSqlBridge.test.js --environment node",
    "test:smoke:frontend-core": "vitest run tests/auth.test.jsx tests/appShellFrame.test.jsx tests/commandCenter.test.jsx tests/dataImporter.preview.test.jsx tests/reportViewer.test.jsx --environment jsdom",
    "test:smoke:frontend-canonical": "pnpm exec vite build && pnpm exec playwright test tests/playwright/sync-flow.spec.js",
    "test:smoke:core": "pnpm run test:smoke:backend-core && pnpm run test:smoke:frontend-core && pnpm run test:smoke:frontend-canonical",
    "build:server-v4": "tsc -p tsconfig.server-v4.build.json",
    "typecheck:server-v4": "tsc -p tsconfig.server-v4.json --noEmit",
    "verify:server-v4": "pnpm run lint:server-v4 && pnpm run typecheck:server-v4 && pnpm run test:server-v4",
    "verify:smoke:core": "pnpm run verify:server-v4 && pnpm run test:smoke:core",
    "healthcheck": "node scripts/healthcheck.mjs",
    "backup:run": "node scripts/run-backup.mjs",
    "ecus:mock": "node scripts/ecus-tools.mjs mock",
    "ecus:inspect": "node scripts/ecus-tools.mjs inspect",
    "dev:frontend": "vite",
    "favicon:update": "node scripts/update-favicon.mjs",
    "cert:ai": "pwsh -File ./scripts/create-ai-https-cert.ps1",
    "precommit": "pnpm run verify:server-v4 && pnpm lint && pnpm exec vitest run --config vitest.frontend.config.mjs tests/reports.test.js tests/store.test.js tests/dataImporter.preview.test.jsx tests/storageClient.test.js",
    "prepare": "pnpm exec simple-git-hooks",
    "test:screenshot": "pnpm build && pnpm exec playwright test tests/playwright/favicon.spec.js",
    "test:playwright": "pnpm exec playwright test",
    "gitnexus:analyze": "npx gitnexus analyze",
    "gitnexus:refresh": "node scripts/gitnexus-refresh.mjs",
    "gitnexus:serve": "npx gitnexus serve --host 127.0.0.1 --port 4747"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@radix-ui/react-accordion": "^1.2.10",
    "@radix-ui/react-alert-dialog": "^1.1.13",
    "@radix-ui/react-aspect-ratio": "^1.1.6",
    "@radix-ui/react-avatar": "^1.1.9",
    "@radix-ui/react-checkbox": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.1.10",
    "@radix-ui/react-context-menu": "^2.2.14",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-dropdown-menu": "^2.1.14",
    "@radix-ui/react-hover-card": "^1.1.13",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-menubar": "^1.1.14",
    "@radix-ui/react-navigation-menu": "^1.2.12",
    "@radix-ui/react-popover": "^1.1.13",
    "@radix-ui/react-progress": "^1.1.6",
    "@radix-ui/react-radio-group": "^1.3.6",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-separator": "^1.1.6",
    "@radix-ui/react-slider": "^1.3.4",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-switch": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.11",
    "@radix-ui/react-toggle": "^1.1.8",
    "@radix-ui/react-toggle-group": "^1.1.9",
    "@radix-ui/react-tooltip": "^1.2.6",
    "@tailwindcss/vite": "^4.1.7",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cors": "^2.8.5",
    "cronstrue": "^2.49.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.3.1",
    "framer-motion": "^12.15.0",
    "helmet": "^8.1.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.510.0",
    "mssql": "^11.0.1",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.9",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-day-picker": "8.10.1",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.3",
    "react-resizable-panels": "^3.0.2",
    "react-router-dom": "^7.6.1",
    "recharts": "^2.15.3",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "tailwindcss": "^4.1.7",
    "vaul": "^1.1.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.5",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitejs/plugin-react": "^4.4.1",
    "axe-core": "^4.10.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-xml-parser": "^4.5.1",
    "globals": "^16.0.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.5.0",
    "simple-git-hooks": "^2.13.1",
    "supertest": "^7.1.1",
    "tw-animate-css": "^1.2.9",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^2.1.4",
    "vitest-axe": "^0.1.0"
  },
  "packageManager": "pnpm@10.4.1+sha512.c753b6c3ad7afa13af388fa6d808035a008e30ea9993f58c6663e2bc5ff21679aa834db094987129aa4d488b86df57f7b634981b2f827cdcacc698cc0cfb88af",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "better-sqlite3",
      "esbuild"
    ]
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm precommit",
    "post-commit": "pnpm gitnexus:refresh",
    "post-merge": "pnpm gitnexus:refresh"
  }
}
