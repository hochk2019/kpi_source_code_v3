/* BẢN ĐÃ KHỚP VỚI store.js, hỗ trợ versioning “áp dụng từ ngày…”,
   Import/Export CSV (mst,company,person_import,person_export,team) */
import React, { useMemo, useState } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card.jsx";
import { Button } from "@/components/ui/button.jsx";
import { Input } from "@/components/ui/input.jsx";
import { getActiveMSTRows, getMSTVersions, saveMSTVersion } from "@/lib/store.js";

const csvEscape = s => `"${String(s||"").replace(/"/g,'""')}"`;

export default function MstAssigner(){
  const versions = getMSTVersions();
  const [applyFrom, setApplyFrom] = useState("");
  const [rows, setRows] = useState(getActiveMSTRows());

  const addRow = () => setRows([...rows, { mst:"", company:"", person_import:"", person_export:"", team:"" }]);
  const remove = (i) => setRows(rows.filter((_,idx)=>idx!==i));
  const change = (i, k, v) => { const cp=[...rows]; cp[i]={...cp[i],[k]:v}; setRows(cp); };

  const doSave = () => {
    saveMSTVersion({ applyFrom, rows });
    alert("Đã lưu cấu hình MST. Bản mới sẽ áp dụng cho dữ liệu từ ngày đã chọn.");
  };

  const doExport = () => {
    const header = "mst,company,person_import,person_export,team\n";
    const body = rows.map(r=>[r.mst,r.company,r.person_import,r.person_export,r.team].map(csvEscape).join(",")).join("\n");
    const blob = new Blob([header+body], {type:"text/csv;charset=utf-8"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "mst_assignment.csv";
    a.click();
  };

  const doImport = async (file) => {
    if(!file) return;
    const text = await file.text();
    const lines = text.split(/\r?\n/).filter(Boolean);
    const result = [];
    for (let i=1;i<lines.length;i++){ // bỏ header
      const parts = lines[i].split(",");
      result.push({
        mst: (parts[0]||"").replace(/"/g,"").trim(),
        company: (parts[1]||"").replace(/"/g,"").trim(),
        person_import: (parts[2]||"").replace(/"/g,"").trim(),
        person_export: (parts[3]||"").replace(/"/g,"").trim(),
        team: (parts[4]||"").replace(/"/g,"").trim(),
      });
    }
    setRows(result);
    alert(`Đã nạp ${result.length} dòng từ CSV.`);
  };

  return (
    <div className="p-4">
      <Card>
        <CardHeader><CardTitle>Gán người phụ trách theo MST</CardTitle></CardHeader>
        <CardContent className="space-y-3">
          <div className="flex gap-2 items-center">
            <Button onClick={addRow}>Thêm dòng</Button>
            <Button variant="outline" onClick={doExport}>Export CSV</Button>
            <label className="px-3 py-2 border rounded bg-white cursor-pointer">Import CSV
              <input type="file" accept=".csv" className="hidden" onChange={e=>doImport(e.target.files[0])} />
            </label>
            <div className="ml-auto flex gap-2 items-center">
              <span>Áp dụng từ ngày</span>
              <Input type="date" value={applyFrom} onChange={e=>setApplyFrom(e.target.value)} className="w-[170px]" />
              <Button onClick={doSave}>Lưu</Button>
            </div>
          </div>

          <div className="overflow-auto border rounded">
            <table className="min-w-[900px] text-sm">
              <thead><tr className="bg-gray-50">
                <th className="p-2 text-left">MST</th>
                <th className="p-2 text-left">Công ty</th>
                <th className="p-2 text-left">Người phụ trách Nhập</th>
                <th className="p-2 text-left">Người phụ trách Xuất</th>
                <th className="p-2 text-left">Tổ đội</th>
                <th className="p-2"></th>
              </tr></thead>
              <tbody>
                {rows.map((r,i)=>(
                  <tr key={i} className="border-t">
                    <td className="p-2"><Input value={r.mst||""} onChange={e=>change(i,"mst",e.target.value)} /></td>
                    <td className="p-2"><Input value={r.company||""} onChange={e=>change(i,"company",e.target.value)} /></td>
                    <td className="p-2"><Input value={r.person_import||""} onChange={e=>change(i,"person_import",e.target.value)} /></td>
                    <td className="p-2"><Input value={r.person_export||""} onChange={e=>change(i,"person_export",e.target.value)} /></td>
                    <td className="p-2"><Input value={r.team||""} onChange={e=>change(i,"team",e.target.value)} /></td>
                    <td className="p-2"><Button variant="ghost" onClick={()=>remove(i)}>Xoá</Button></td>
                  </tr>
                ))}
                {rows.length===0 && <tr><td className="p-3 text-center text-gray-500" colSpan={6}>Chưa có dữ liệu</td></tr>}
              </tbody>
            </table>
          </div>
        </CardContent>
      </Card>
    </div>
  );
}
