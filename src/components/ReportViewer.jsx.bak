import React, { useMemo, useState } from "react";
import { Card, CardHeader, CardTitle, CardContent } from "@/components/ui/card.jsx";
import { Button } from "@/components/ui/button.jsx";
import { getData, getMSTCompanyMap } from "@/lib/store.js";
import { BarChart, Bar, XAxis, YAxis, Tooltip, ResponsiveContainer } from "recharts";
import * as XLSX from "xlsx";

// helpers
const toDate = (s) => (s ? new Date(s) : null);
const fmtDate = (d) => (d ? d.toISOString().slice(0, 10) : "");
const sum = (arr, pick = (x) => x) => Math.round(arr.reduce((a, b) => a + (Number(pick(b)) || 0), 0) * 10) / 10;

export default function ReportViewer() {
  const [from, setFrom] = useState("");
  const [to, setTo] = useState("");
  const [scope, setScope] = useState("employee"); // employee | team | company
  const [selectedEmployee, setSelectedEmployee] = useState("");
  const [splitPrint, setSplitPrint] = useState(true);
  const [target, setTarget] = useState(500); // mục tiêu để tô màu

  const data = getData();
  const mstMap = getMSTCompanyMap();

  const filtered = useMemo(() => {
    const dFrom = from ? toDate(from) : null;
    const dTo = to ? new Date(to + "T23:59:59") : null;
    return (data || []).filter((r) => {
      const d = r.date ? toDate(r.date) : null;
      if (dFrom && (!d || d < dFrom)) return false;
      if (dTo && (!d || d > dTo)) return false;
      return true;
    });
  }, [data, from, to]);

  const uniqueEmps = useMemo(
    () => Array.from(new Set((filtered || []).map((x) => x.employee).filter(Boolean))).sort((a, b) => a.localeCompare(b, "vi")),
    [filtered]
  );

  // Gom nhóm theo scope
  const groups = useMemo(() => {
    if (scope === "company") return [{ id: "company", name: "Toàn công ty", subset: filtered }];
    if (scope === "employee") {
      const map = new Map();
      filtered.forEach((x) => {
        if (selectedEmployee && x.employee !== selectedEmployee) return;
        const k = x.employee || "(Chưa có tên)";
        if (!map.has(k)) map.set(k, []);
        map.get(k).push(x);
      });
      return Array.from(map.entries())
        .map(([k, arr]) => ({ id: k, name: k, subset: arr }))
        .sort((a, b) => a.name.localeCompare(b.name, "vi"));
    }
    // team
    const map = new Map();
    filtered.forEach((x) => {
      const k = x.team || "(Chưa có tổ)";
      if (!map.has(k)) map.set(k, []);
      map.get(k).push(x);
    });
    return Array.from(map.entries())
      .map(([k, arr]) => ({ id: k, name: k, subset: arr }))
      .sort((a, b) => a.name.localeCompare(b.name, "vi"));
  }, [filtered, scope, selectedEmployee]);

  // Tổng quan nhanh cho vùng lọc hiện tại
  const totalKPI = sum(filtered, (x) => x.kpi);
  const totalDecl = filtered.length;
  const topEmp = useMemo(() => {
    const m = new Map();
    filtered.forEach((x) => m.set(x.employee || "(Chưa có)", (m.get(x.employee || "(Chưa có)") || 0) + (x.kpi || 0)));
    return Array.from(m.entries()).sort((a, b) => b[1] - a[1])[0] || ["—", 0];
  }, [filtered]);
  const topCus = useMemo(() => {
    const m = new Map();
    filtered.forEach((x) => {
      const key = `${x.customer || mstMap.get(x.mst || "") || "(Chưa có)"}|${x.mst || ""}`;
      m.set(key, (m.get(key) || 0) + (x.kpi || 0));
    });
    return Array.from(m.entries()).sort((a, b) => b[1] - a[1])[0] || ["—", 0];
  }, [filtered, mstMap]);

  // Dữ liệu biểu đồ cột theo ngày
  const byDay = useMemo(() => {
    const m = new Map();
    filtered.forEach((x) => {
      const d = x.date ? fmtDate(new Date(x.date)) : "";
      if (!d) return;
      m.set(d, (m.get(d) || 0) + (x.kpi || 0));
    });
    return Array.from(m.entries())
      .map(([d, v]) => ({ d, v: Math.round(v * 10) / 10 }))
      .sort((a, b) => (a.d < b.d ? -1 : 1));
  }, [filtered]);

  function setQuickRange(kind) {
    const now = new Date();
    if (kind === "day") {
      const d = fmtDate(now);
      setFrom(d); setTo(d); return;
    }
    if (kind === "month") {
      const s = new Date(now.getFullYear(), now.getMonth(), 1);
      const e = new Date(now.getFullYear(), now.getMonth() + 1, 0);
      setFrom(fmtDate(s)); setTo(fmtDate(e)); return;
    }
    if (kind === "quarter") {
      const q = Math.floor(now.getMonth() / 3);
      const s = new Date(now.getFullYear(), q * 3, 1);
      const e = new Date(now.getFullYear(), q * 3 + 3, 0);
      setFrom(fmtDate(s)); setTo(fmtDate(e)); return;
    }
    if (kind === "year") {
      const s = new Date(now.getFullYear(), 0, 1);
      const e = new Date(now.getFullYear(), 11, 31);
      setFrom(fmtDate(s)); setTo(fmtDate(e)); return;
    }
  }

  return (
    <div className="max-w-6xl mx-auto p-4">
      {/* Bộ lọc */}
      <Card>
        <CardHeader><CardTitle>Bộ lọc</CardTitle></CardHeader>
        <CardContent className="p-4 grid md:grid-cols-7 gap-3 print:hidden">
          <div className="space-y-1">
            <label className="text-sm">Từ ngày</label>
            <input className="border rounded p-2 w-full" type="date" value={from} onChange={(e) => setFrom(e.target.value)} />
          </div>
          <div className="space-y-1">
            <label className="text-sm">Đến ngày</label>
            <input className="border rounded p-2 w-full" type="date" value={to} onChange={(e) => setTo(e.target.value)} />
          </div>
          <div className="space-y-1">
            <label className="text-sm">Phạm vi</label>
            <select className="border rounded p-2 w-full" value={scope} onChange={(e) => setScope(e.target.value)}>
              <option value="employee">Theo nhân viên</option>
              <option value="team">Theo tổ/đội</option>
              <option value="company">Toàn công ty</option>
            </select>
          </div>
          {scope === "employee" && (
            <div className="space-y-1">
              <label className="text-sm">Nhân viên</label>
              <select className="border rounded p-2 w-full" value={selectedEmployee} onChange={(e)=>setSelectedEmployee(e.target.value)}>
                <option value="">(Tất cả)</option>
                {uniqueEmps.map(e => <option key={e} value={e}>{e}</option>)}
              </select>
            </div>
          )}
          <div className="space-y-1">
            <label className="text-sm">Mốc thời gian</label>
            <select className="border rounded p-2 w-full" onChange={(e)=>setQuickRange(e.target.value)} defaultValue="">
              <option value="">(Chọn nhanh)</option>
              <option value="day">Hôm nay</option>
              <option value="month">Tháng này</option>
              <option value="quarter">Quý này</option>
              <option value="year">Năm nay</option>
            </select>
          </div>
          <div className="space-y-1">
            <label className="text-sm">Mục tiêu KPI</label>
            <input className="border rounded p-2 w-full" type="number" value={target} onChange={(e)=>setTarget(Number(e.target.value||0))} />
          </div>
          <div className="space-y-1">
            <label className="text-sm invisible">In</label>
            <Button className="w-full" onClick={() => window.print()}>In báo cáo</Button>
          </div>
          {scope === "employee" && selectedEmployee === "" && (
            <div className="col-span-full flex items-center gap-2">
              <input id="split" type="checkbox" checked={splitPrint} onChange={(e)=>setSplitPrint(e.target.checked)} />
              <label htmlFor="split" className="text-sm">In mỗi nhân viên một trang</label>
            </div>
          )}
        </CardContent>
      </Card>

      {/* Thẻ thống kê nhanh + Spark bar */}
      <div className="grid md:grid-cols-4 gap-3 my-4">
        <Card><CardContent className="p-4"><div className="text-sm text-gray-500">Tổng KPI</div><div className="text-2xl font-semibold">{totalKPI.toLocaleString('vi-VN')}</div></CardContent></Card>
        <Card><CardContent className="p-4"><div className="text-sm text-gray-500">Số tờ khai</div><div className="text-2xl font-semibold">{totalDecl.toLocaleString('vi-VN')}</div></CardContent></Card>
        <Card><CardContent className="p-4"><div className="text-sm text-gray-500">Top nhân viên</div><div className="text-xl font-semibold">{topEmp[0]}</div><div className="text-sm">{Math.round(topEmp[1]*10)/10}</div></CardContent></Card>
        <Card><CardContent className="p-4"><div className="text-sm text-gray-500">Top khách hàng</div><div className="text-xl font-semibold">{topCus[0].split('|')[0]}</div><div className="text-sm">{Math.round(topCus[1]*10)/10}</div></CardContent></Card>
      </div>
      <Card className="mb-4">
        <CardHeader><CardTitle>KPI theo ngày</CardTitle></CardHeader>
        <CardContent style={{height:220}}>
          <ResponsiveContainer width="100%" height="100%">
            <BarChart data={byDay}><XAxis dataKey="d" /><YAxis /><Tooltip /><Bar dataKey="v" /></BarChart>
          </ResponsiveContainer>
        </CardContent>
      </Card>

      {/* Các khối báo cáo */}
      <div className="space-y-6">
        {groups.map((g,i)=>(
          <ReportSection
            key={g.id||i}
            id={g.id}
            title={`Báo cáo KPI – ${g.name}`}
            scope={scope}
            from={from}
            to={to}
            split={splitPrint && scope==='employee' && selectedEmployee==='' }
            subset={g.subset}
            target={target}
            mstMap={mstMap}
          />
        ))}
      </div>
    </div>
  );
}

function ReportSection({ id, title, scope, from, to, split, subset, target, mstMap }) {
  const totalData = sum(subset, x=>x.kpi)

  // Gom theo công ty|MST
  const rows = useMemo(()=>{
    const m = new Map()
    subset.forEach(x=>{
      const name = (x.customer || mstMap.get(x.mst || '') || '(Chưa có)')
      const key = `${name}|${x.mst||''}`
      if(!m.has(key)) m.set(key, { name, mst: x.mst||'', kpi:0, count:0, types: new Map() })
      const obj = m.get(key)
      obj.kpi += (x.kpi||0); obj.count += 1
      const code = String(x.loaiHinh||'').toUpperCase()
      const stat = obj.types.get(code) || { count:0, kpi:0 }
      stat.count += 1; stat.kpi += (x.kpi||0)
      obj.types.set(code, stat)
    })
    return Array.from(m.values()).sort((a,b)=>a.name.localeCompare(b.name,'vi'))
  }, [subset, mstMap])

  // Export Excel
  function exportExcel(){
    const wb = XLSX.utils.book_new()
    // Summary sheet
    const summary = [
      ["Tiêu đề", title],
      ["Từ ngày", from||"Không giới hạn"],
      ["Đến ngày", to||"Không giới hạn"],
      ["Tổng KPI", totalData],
      ["Số tờ khai", subset.length],
    ]
    XLSX.utils.book_append_sheet(wb, XLSX.utils.aoa_to_sheet(summary), "Tóm tắt")

    // Companies
    const comp = rows.map(r=>({ Cong_ty: r.name, MST: r.mst, So_to_khai: r.count, KPI: Math.round(r.kpi*10)/10 }))
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(comp), "Cong_ty")

    // Types per company (long format)
    const types = []
    rows.forEach(r=>{
      r.types.forEach((stat, code)=>{
        types.push({ Cong_ty: r.name, MST:r.mst, Loai_hinh:code, So_to_khai:stat.count, KPI: Math.round(stat.kpi*10)/10 })
      })
    })
    XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(types), "Loai_hinh")

    XLSX.writeFile(wb, `${title.replaceAll(' ','_')}.xlsx`)
  }

  // màu ngưỡng
  const ratio = target>0 ? totalData/target : 1
  const klass = ratio>=1 ? "bg-green-50" : ratio>=0.8 ? "bg-yellow-50" : "bg-red-50"

  return (
    <Card className={split ? "break-before-page" : ""}>
      <CardHeader>
        <div className="flex items-center justify-between">
          <div>
            <CardTitle>{title}</CardTitle>
            <div className="text-sm text-gray-500">{from||"Không giới hạn"} – {to||"Không giới hạn"}</div>
          </div>
          <Button onClick={exportExcel}>Xuất Excel</Button>
        </div>
      </CardHeader>
      <CardContent className="space-y-4">
        {/* Tổng hợp */}
        <div className={`border rounded p-3 ${klass}`}>
          <div className="grid md:grid-cols-4 gap-3">
            <div><div className="text-sm text-gray-500">KPI từ tờ khai</div><div className="text-2xl font-semibold">{totalData.toLocaleString('vi-VN')}</div></div>
            <div><div className="text-sm text-gray-500">Điều chỉnh</div><div className="text-2xl font-semibold">0</div><div className="text-xs text-gray-500">(* giữ nguyên như trước – phần điều chỉnh nhập tay bạn đang dùng ở bản cũ; nếu muốn mình gộp vào đây ở bước sau)</div></div>
            <div><div className="text-sm text-gray-500">Tổng</div><div className="text-2xl font-semibold">{totalData.toLocaleString('vi-VN')}</div></div>
            <div><div className="text-sm text-gray-500">Mục tiêu</div><div className="text-2xl font-semibold">{target.toLocaleString('vi-VN')}</div></div>
          </div>
        </div>

        {/* Bảng công ty */}
        <div className="overflow-x-auto">
          <div className="text-sm font-semibold mb-2">Danh sách công ty / MST / Số tờ khai / Điểm KPI</div>
          <table className="w-full">
            <thead>
              <tr>
                <th className="border p-2 text-left">Công ty</th>
                <th className="border p-2 text-left">MST</th>
                <th className="border p-2 text-right">Số tờ khai</th>
                <th className="border p-2 text-right">KPI</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r,i)=>(
                <React.Fragment key={i}>
                  <tr>
                    <td className="border p-2">{r.name}</td>
                    <td className="border p-2">{r.mst}</td>
                    <td className="border p-2 text-right">{r.count}</td>
                    <td className="border p-2 text-right">{Math.round(r.kpi*10)/10}</td>
                  </tr>
                  <tr>
                    <td colSpan={4} className="border p-2 bg-gray-50">
                      <details>
                        <summary className="cursor-pointer text-xs font-semibold">Chi tiết theo loại hình</summary>
                        <div className="overflow-x-auto mt-2">
                          <table className="w-full text-xs">
                            <thead>
                              <tr>
                                <th className="border p-1 text-left">Loại hình</th>
                                <th className="border p-1 text-right">Số tờ khai</th>
                                <th className="border p-1 text-right">KPI</th>
                              </tr>
                            </thead>
                            <tbody>
                              {Array.from(r.types.entries()).sort((a,b)=>a[0].localeCompare(b[0],'vi')).map(([code,stat],j)=>(
                                <tr key={j}>
                                  <td className="border p-1">{code}</td>
                                  <td className="border p-1 text-right">{stat.count}</td>
                                  <td className="border p-1 text-right">{Math.round(stat.kpi*10)/10}</td>
                                </tr>
                              ))}
                            </tbody>
                          </table>
                        </div>
                      </details>
                    </td>
                  </tr>
                </React.Fragment>
              ))}
            </tbody>
          </table>
        </div>
      </CardContent>
    </Card>
  )
}
