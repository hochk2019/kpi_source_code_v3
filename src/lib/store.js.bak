// src/lib/store.js
// -----------------
// Lưu trữ data vào localStorage + các helper đồng bộ giữa các màn (Import, Gán MST, Quy tắc)

const KEYS = {
  data: "declarations_v2",
  mst: "mst_rows_v2",
  rules: "kpi_rules_v2",
  logs: "import_logs_v1",
};

function readJSON(key, fallback) {
  try {
    const s = localStorage.getItem(key);
    if (!s) return fallback;
    const v = JSON.parse(s);
    return v ?? fallback;
  } catch {
    return fallback;
  }
}

function writeJSON(key, val) {
  localStorage.setItem(key, JSON.stringify(val));
}

// --------- Normalizers ---------
export function normalizeStr(v) {
  if (v == null) return "";
  const s = String(v).trim();
  return s;
}

// Giữ nguyên số 0 đầu, loại bỏ khoảng trắng/ký tự lạ
export function normalizeMST(v) {
  if (v == null) return "";
  let s = String(v).trim();
  // nếu là số dạng 1.234E+11 từ Excel -> chuyển sang chuỗi số nguyên
  if (/e\+/i.test(s)) {
    const num = Number(s);
    if (Number.isFinite(num)) s = String(Math.trunc(num));
  }
  // bỏ mọi ký tự không phải 0-9
  s = s.replace(/[^\d]/g, "");
  return s;
}

// Chuẩn hoá về yyyy-mm-dd (nhận dd/mm/yyyy, mm/dd/yyyy, Date, ...)
export function toISODate(v) {
  if (!v) return "";
  if (v instanceof Date && !isNaN(v)) {
    return v.toISOString().slice(0, 10);
  }
  const s = String(v).trim();
  // yyyy-mm-dd
  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
  // dd/mm/yyyy
  const m1 = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (m1) {
    const [_, d, m, y] = m1;
    const dd = String(d).padStart(2, "0");
    const mm = String(m).padStart(2, "0");
    return `${y}-${mm}-${dd}`;
  }
  // mm/dd/yyyy
  const m2 = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if (m2) {
    const [_, m, d, y] = m2;
    const dd = String(d).padStart(2, "0");
    const mm = String(m).padStart(2, "0");
    return `${y}-${mm}-${dd}`;
  }
  return "";
}

// --------- DATA (tờ khai) ---------
export function getData() {
  return readJSON(KEYS.data, []);
}

// Giữ lại vì rules.js có import
export function setData(list) {
  writeJSON(KEYS.data, Array.isArray(list) ? list : []);
}

const EXPORT_CODES = new Set(["B11","B12","B13","E42","E52","E62","E82","G22","G23","G24","G61","H21"]);
const IMPORT_CODES = new Set(["E11","E13","E15","E21","E31","E41","A11","A12","A41","A42","G12","G13","G51","H11"]);

function inferDirection(row) {
  const so = normalizeStr(row.soToKhai);
  const lh = normalizeStr(row.loaiHinh).toUpperCase();
  if (/^30\d{10}/.test(so)) return "X"; // Xuất
  if (/^10\d{10}/.test(so)) return "N"; // Nhập
  if (EXPORT_CODES.has(lh)) return "X";
  if (IMPORT_CODES.has(lh)) return "N";
  return ""; // không xác định
}

// Upsert theo 11 số đầu của số tờ khai (bản sửa mới nhất)
// options: { upsertBy11: true, overwrite: false, autoAssign: true }
export function upsertDeclarations(newRows = [], options = {}) {
  const { upsertBy11 = true, overwrite = false, autoAssign = true } = options;
  const old = overwrite ? [] : getData();
  const byKey = new Map();
  // index old rows
  for (const r of old) {
    const key = upsertBy11 ? (normalizeStr(r.soToKhai).slice(0, 11) + "|" + (r.mst || "")) : (normalizeStr(r.soToKhai) || JSON.stringify(r));
    byKey.set(key, r);
  }

  // tính map MST -> info để auto gán
  const mstMapArr = getMSTMap();
  const mstInfoByMST = new Map(mstMapArr.map(x => [normalizeMST(x.mst), x]));

  for (const raw of newRows) {
    const r = { ...raw };
    r.date = toISODate(r.date || r.ngay || r["Ngày"] || r["date"]);
    r.soToKhai = normalizeStr(r.soToKhai || r["Số TK"] || r["Số tờ khai"] || r.sotk || r.so_tk);
    r.mst = normalizeMST(r.mst || r["MST"]);
    r.customer = normalizeStr(r.customer || r["Công ty"] || r.company);
    r.loaiHinh = normalizeStr(r.loaiHinh || r["Loại hình"]);
    r.num_items = Number(r.num_items ?? r["Mục hàng"] ?? r.muc_hang ?? 0) || 0;

    // gán chiều (N/X)
    r.direction = r.direction || inferDirection(r);

    // gom mã giấy phép từ mọi cột "Mã giấy phép" (nếu có)
    const codes = [];
    for (const k of Object.keys(raw)) {
      const kk = String(k).toLowerCase();
      if (kk.startsWith("mã giấy phép") || kk.startsWith("ma giay phep") || kk.startsWith("license")) {
        const cell = raw[k];
        if (cell != null && String(cell).trim() !== "") {
          String(cell).split(/[;,]/).forEach(x => { const z = String(x).trim(); if (z) codes.push(z); });
        }
      }
    }
    r.licenseCodes = Array.from(new Set(codes));

    // auto gán nhân viên/tổ nếu trống
    if (autoAssign && r.mst) {
      const info = mstInfoByMST.get(r.mst);
      if (info) {
        r.person_import = r.person_import || info.person_import || "";
        r.person_export = r.person_export || info.person_export || "";
        r.team = r.team || info.team || "";
      }
    }

    const key = upsertBy11 ? (normalizeStr(r.soToKhai).slice(0, 11) + "|" + (r.mst || "")) : (normalizeStr(r.soToKhai) || JSON.stringify(r));
    const prev = byKey.get(key);
    if (!prev) {
      byKey.set(key, r);
    } else {
      // nếu trùng 11 số đầu thì chọn bản có số cuối lớn hơn
      const a = normalizeStr(prev.soToKhai);
      const b = normalizeStr(r.soToKhai);
      const lastA = Number(a.slice(-1)) || 0;
      const lastB = Number(b.slice(-1)) || 0;
      byKey.set(key, lastB >= lastA ? { ...prev, ...r } : prev);
    }
  }

  const merged = Array.from(byKey.values());
  setData(merged);
  return merged;
}

// --------- MST (mapping) ---------
export function getMSTMap() {
  return readJSON(KEYS.mst, []);
}

export function saveMSTMap(rows) {
  // chuẩn hóa + unique theo mst
  const arr = Array.isArray(rows) ? rows : [];
  const m = new Map();
  for (const r0 of arr) {
    const r = {
      mst: normalizeMST(r0.mst),
      company: normalizeStr(r0.company),
      person_import: normalizeStr(r0.person_import),
      person_export: normalizeStr(r0.person_export),
      team: normalizeStr(r0.team),
      effective_from: toISODate(r0.effective_from || ""),
    };
    if (!r.mst) continue;
    m.set(r.mst, r); // ghi đè theo mst
  }
  const out = Array.from(m.values());
  writeJSON(KEYS.mst, out);
  return out;
}

// Trả về mảng đã merge vào localStorage
export function upsertMSTRows(newRows = []) {
  const old = getMSTMap();
  const m = new Map(old.map(r => [normalizeMST(r.mst), r]));
  for (const x of (Array.isArray(newRows) ? newRows : [])) {
    const mst = normalizeMST(x.mst);
    if (!mst) continue;
    m.set(mst, { ...m.get(mst), ...x, mst });
  }
  const merged = Array.from(m.values());
  writeJSON(KEYS.mst, merged);
  return merged;
}

// Cho các màn khác dùng (giữ tương thích cũ)
export function getMSTCompanyMap() {
  const map = {};
  for (const r of getMSTMap()) {
    if (r.mst) map[r.mst] = r.company || "";
  }
  return map;
}

// --------- Logs ---------
export function pushImportLog(msg) {
  const arr = readJSON(KEYS.logs, []);
  arr.unshift({ time: new Date().toISOString(), msg });
  writeJSON(KEYS.logs, arr.slice(0, 50));
}

export function getImportLogs() {
  return readJSON(KEYS.logs, []);
}

export default {};
